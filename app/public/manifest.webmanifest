{
  "id": "/",
  "name": "Vesper",
  "short_name": "Vesper",
  "description": "Community chatroom-first per donne lesbiche, bi, queer e persone LGBTQ+ femminili.",
  "lang": "it",
  "dir": "ltr",
  "categories": [
    "social",
    "lifestyle"
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://vespercommunity.com/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "background_color": "#171520",
  "theme_color": "#171520",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/phone-foyer-v2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Il Foyer: la chat principale della community"
    },
    {
      "src": "/screenshots/phone-stanze-v2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Le stanze tematiche"
    },
    {
      "src": "/screenshots/phone-dm-v2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Messaggi privati"
    },
    {
      "src": "/screenshots/wide-v2.png",
      "sizes": "1920x1200",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Stanze e Foyer di Vesper"
    }
  ]
}
