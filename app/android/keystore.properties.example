# Copia questo file in `keystore.properties` (stessa cartella) e compila i valori.
# keystore.properties è gitignorato: le password NON entrano mai nel repo.
#
# Il keystore ufficiale di Vesper è su Bitwarden (SHA256 20:05:31…C2:29,
# alias my-key-alias). È lo STESSO usato per la TWA: va riusato per poter
# aggiornare la scheda Play esistente com.vespercommunity.app.
#
# storeFile = percorso assoluto al file .keystore (usa / anche su Windows,
#             es. C:/Users/tuonome/keys/signing.keystore)

storeFile=C:/percorso/al/signing.keystore
storePassword=LA_PASSWORD_DEL_KEYSTORE
keyAlias=my-key-alias
keyPassword=LA_PASSWORD_DELLA_CHIAVE
